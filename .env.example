SIDS_ENV=development
WEB_ORIGIN=http://localhost:5173
CORE_API_PORT=8080

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sids
DATABASE_USER=sids_user
DATABASE_PASSWORD=replace-with-a-random-development-password

AUTH_ISSUER=sids-core-api
AUTH_AUDIENCE=sids-web
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_TOKEN_MINUTES=120

AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=replace-with-at-least-24-random-characters
AI_CONNECT_TIMEOUT=2s
AI_READ_TIMEOUT=20s

STORAGE_LOCAL_ROOT=.data/private-images
CORE_API_MAX_MULTIPART_SIZE=8MB
CORE_API_MAX_MULTIPART_REQUEST_SIZE=9MB
CORE_API_MAX_IMAGE_BYTES=8388608
CORE_API_MAX_IMAGE_PIXELS=20000000

AI_SERVICE_MAX_UPLOAD_BYTES=8388608
AI_SERVICE_MAX_IMAGE_PIXELS=20000000
