# SIDS application identity
SIDS_ENV=development
SIDS_PUBLIC_BASE_URL=http://localhost:8080

# PostgreSQL (future core API)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sids
DATABASE_USER=replace-me
DATABASE_PASSWORD=replace-me

# Valkey (future transient cache, controls, and job transport)
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=replace-me

# S3-compatible object storage (future imagery storage)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=sids-images
STORAGE_ACCESS_KEY=replace-me
STORAGE_SECRET_KEY=replace-me

# Python AI inference service (future)
AI_SERVICE_URL=http://localhost:8000
AI_REQUEST_TIMEOUT_SECONDS=30

# OpenID Connect identity provider (future)
OIDC_ISSUER_URI=https://replace-me.example
OIDC_CLIENT_ID=replace-me
OIDC_CLIENT_SECRET=replace-me

# Weather provider (future)
WEATHER_PROVIDER_URL=https://replace-me.example
WEATHER_API_KEY=replace-me

# Observability (future)
OBSERVABILITY_OTLP_ENDPOINT=http://localhost:4317
OBSERVABILITY_SERVICE_NAMESPACE=sids
