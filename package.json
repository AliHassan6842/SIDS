{
  "name": "sids-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "SIDS 2026 private monorepo",
  "packageManager": "npm@11.16.0",
  "scripts": {
    "setup:dev": "powershell -ExecutionPolicy Bypass -File scripts/setup-dev.ps1",
    "dev": "docker compose --env-file .env -f infra/docker-compose.yml up --build",
    "api:dev": "powershell -ExecutionPolicy Bypass -File scripts/run-core-api.ps1",
    "web:dev": "npm --prefix apps/web run dev",
    "web:typecheck": "npm --prefix apps/web run typecheck",
    "web:build": "npm --prefix apps/web run build",
    "web:check": "npm --prefix apps/web run lint",
    "web:test": "npm --prefix apps/web test",
    "web:e2e": "npm --prefix apps/web run e2e",
    "ai:dev": "python -m uvicorn sids_ai.app:app --app-dir services/ai-service/src --reload --port 8000",
    "ai:test": "python -m pytest services/ai-service/tests",
    "ai:lint": "python -m ruff check services/ai-service/src services/ai-service/tests",
    "ai:typecheck": "python -m mypy services/ai-service/src",
    "api:test": "cd services/core-api && mvnw.cmd test",
    "api:package": "cd services/core-api && mvnw.cmd package",
    "contracts:test": "python -m pytest packages/contracts/tests",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d db",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "infra:config": "docker compose --env-file .env -f infra/docker-compose.yml config --quiet",
    "infra:build": "docker compose --env-file .env -f infra/docker-compose.yml build ai-service core-api",
    "test": "npm run contracts:test && npm run ai:test && npm run api:test && npm run web:test",
    "check": "npm run contracts:test && npm run ai:lint && npm run ai:typecheck && npm run web:check && npm run web:typecheck && npm run web:build",
    "lint": "npm --prefix apps/web run lint"
  }
}
