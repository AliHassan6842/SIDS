{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sids.local/contracts/v1/ScanResult.schema.json",
  "title": "Authorized public scan result",
  "type": "object",
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "crop": { "$ref": "Crop.schema.json" },
    "status": { "enum": ["IDENTIFIED", "UNKNOWN", "REJECTED_IMAGE", "FAILED"] },
    "reason": {
      "type": ["string", "null"],
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "bbox": { "oneOf": [{ "$ref": "BoundingBox.schema.json" }, { "type": "null" }] },
    "imageUrl": { "type": ["string", "null"], "format": "uri-reference" },
    "pest": { "oneOf": [{ "$ref": "Pest.schema.json" }, { "type": "null" }] },
    "model": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "datasetVersion": { "type": "string", "minLength": 1 }
          },
          "required": ["id", "version", "datasetVersion"],
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "required": ["id", "crop", "status", "reason", "confidence", "bbox", "imageUrl", "pest", "model", "createdAt"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "IDENTIFIED" } }, "required": ["status"] },
      "then": {
        "properties": {
          "reason": { "type": "null" },
          "confidence": { "type": "number" },
          "pest": { "type": "object" },
          "model": { "type": "object" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "UNKNOWN" } }, "required": ["status"] },
      "then": {
        "properties": {
          "reason": { "enum": ["LOW_CONFIDENCE", "NO_DETECTION", "CLASS_UNCERTAIN", "MODEL_UNAVAILABLE"] },
          "confidence": { "type": "null" },
          "bbox": { "type": "null" },
          "pest": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "REJECTED_IMAGE" } }, "required": ["status"] },
      "then": {
        "properties": {
          "reason": { "enum": ["TOO_DARK", "TOO_BRIGHT", "TOO_BLURRY", "SUBJECT_TOO_SMALL", "NO_INSECT_CANDIDATE", "INVALID_IMAGE"] },
          "confidence": { "type": "null" },
          "bbox": { "type": "null" },
          "pest": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "FAILED" } }, "required": ["status"] },
      "then": {
        "properties": {
          "reason": { "type": "string" },
          "confidence": { "type": "null" },
          "bbox": { "type": "null" },
          "pest": { "type": "null" },
          "model": { "type": "null" }
        }
      }
    }
  ]
}
