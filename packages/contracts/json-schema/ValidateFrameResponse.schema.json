{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sids.local/contracts/v1/ValidateFrameResponse.schema.json",
  "title": "Validate frame response",
  "type": "object",
  "properties": {
    "valid": { "type": "boolean" },
    "reason": {
      "type": ["string", "null"],
      "enum": [null, "TOO_DARK", "TOO_BRIGHT", "TOO_BLURRY", "SUBJECT_TOO_SMALL", "NO_INSECT_CANDIDATE", "INVALID_IMAGE"]
    },
    "insectCandidate": { "type": "boolean" },
    "quality": {
      "type": "object",
      "properties": {
        "brightness": { "enum": ["LOW", "OK", "HIGH"] },
        "blur": { "enum": ["LOW", "OK"] },
        "subjectSize": { "enum": ["LOW", "OK", "UNKNOWN"] }
      },
      "required": ["brightness", "blur", "subjectSize"],
      "additionalProperties": false
    }
  },
  "required": ["valid", "reason", "insectCandidate", "quality"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "valid": { "const": true } }, "required": ["valid"] },
      "then": {
        "properties": {
          "reason": { "type": "null" },
          "insectCandidate": { "const": true }
        }
      },
      "else": { "properties": { "reason": { "type": "string" } } }
    }
  ]
}
