{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sids.local/contracts/v1/ErrorModel.schema.json",
  "title": "ErrorModel",
  "description": "Standard error response schema across all services.",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
      "description": "A domain-specific, stable error code (e.g., 'IMAGE_DECODE_FAILED', 'RATE_LIMIT_EXCEEDED')."
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Human-readable error description."
    },
    "retryable": {
      "type": "boolean"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]{1,64}$"
    },
    "details": {
      "type": "object",
      "description": "Bounded, non-sensitive code-specific context.",
      "maxProperties": 10,
      "additionalProperties": true
    }
  },
  "required": ["code", "message", "retryable", "requestId", "details"],
  "additionalProperties": false
}
