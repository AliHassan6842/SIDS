{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sids.ai/schema/ImageQuality.schema.json",
  "title": "ImageQuality",
  "description": "Image quality assessment results including checks like blur, exposure, and resolution.",
  "type": "object",
  "properties": {
    "acceptable": {
      "type": "boolean",
      "description": "True if the image passed all quality checks."
    },
    "issues": {
      "type": "array",
      "description": "List of quality issues identified.",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "IMAGE_TOO_BLURRY",
              "IMAGE_UNDEREXPOSED",
              "IMAGE_OVEREXPOSED",
              "RESOLUTION_TOO_LOW",
              "RESOLUTION_TOO_HIGH",
              "IMAGE_CORRUPTED",
              "DUPLICATE_IMAGE"
            ]
          },
          "severity": {
            "type": "string",
            "enum": ["WARNING", "ERROR"]
          },
          "measurement": {
            "type": "number",
            "description": "The measured value for the issue."
          },
          "threshold": {
            "type": "number",
            "description": "The threshold value that was violated."
          }
        },
        "required": ["code", "severity"]
      }
    },
    "requestedAction": {
      "type": "string",
      "enum": ["PROCEED", "RETAKE", "ENHANCE"],
      "description": "Recommended action based on the quality assessment."
    }
  },
  "required": ["acceptable", "issues", "requestedAction"]
}
