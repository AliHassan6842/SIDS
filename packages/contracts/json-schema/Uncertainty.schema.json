{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sids.ai/schema/Uncertainty.schema.json",
  "title": "Uncertainty",
  "description": "Uncertainty metrics for a prediction.",
  "type": "object",
  "properties": {
    "confidenceScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Calibrated confidence score of the prediction."
    },
    "entropy": {
      "type": "number",
      "minimum": 0,
      "description": "Predictive entropy (higher means more uncertain)."
    },
    "isOutlier": {
      "type": "boolean",
      "description": "True if the sample is detected as out-of-distribution."
    },
    "requiresHumanReview": {
      "type": "boolean",
      "description": "True if the uncertainty is high enough to require human validation."
    }
  },
  "required": ["confidenceScore"]
}
