{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sids.local/contracts/v1/UpdateProfileRequest.schema.json",
  "title": "Update profile request",
  "type": "object",
  "properties": {
    "fullName": { "type": "string", "minLength": 2, "maxLength": 120, "pattern": ".*\\S.*" },
    "language": { "type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$" }
  },
  "required": ["fullName"],
  "additionalProperties": false
}
