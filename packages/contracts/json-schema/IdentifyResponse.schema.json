{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sids.local/contracts/v1/IdentifyResponse.schema.json",
  "title": "Private AI identify response",
  "type": "object",
  "properties": {
    "status": { "enum": ["IDENTIFIED", "UNKNOWN", "REJECTED_IMAGE"] },
    "reason": {
      "type": ["string", "null"],
      "enum": [null, "LOW_CONFIDENCE", "NO_DETECTION", "CLASS_UNCERTAIN", "MODEL_UNAVAILABLE", "TOO_DARK", "TOO_BRIGHT", "TOO_BLURRY", "SUBJECT_TOO_SMALL", "NO_INSECT_CANDIDATE", "INVALID_IMAGE"]
    },
    "prediction": {
      "type": ["object", "null"],
      "properties": {
        "pestId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "bbox": { "oneOf": [{ "$ref": "BoundingBox.schema.json" }, { "type": "null" }] }
      },
      "required": ["pestId", "confidence"],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "datasetVersion": { "type": "string", "minLength": 1 }
      },
      "required": ["id", "version", "datasetVersion"],
      "additionalProperties": false
    }
  },
  "required": ["status", "reason", "prediction", "model"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "IDENTIFIED" } }, "required": ["status"] },
      "then": {
        "properties": {
          "reason": { "type": "null" },
          "prediction": { "type": "object" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "UNKNOWN" } }, "required": ["status"] },
      "then": {
        "properties": {
          "reason": { "enum": ["LOW_CONFIDENCE", "NO_DETECTION", "CLASS_UNCERTAIN", "MODEL_UNAVAILABLE"] },
          "prediction": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "REJECTED_IMAGE" } }, "required": ["status"] },
      "then": {
        "properties": {
          "reason": { "enum": ["TOO_DARK", "TOO_BRIGHT", "TOO_BLURRY", "SUBJECT_TOO_SMALL", "NO_INSECT_CANDIDATE", "INVALID_IMAGE"] },
          "prediction": { "type": "null" }
        }
      }
    }
  ]
}
