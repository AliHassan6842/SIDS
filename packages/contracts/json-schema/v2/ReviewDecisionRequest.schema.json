{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sids.local/contracts/v2/ReviewDecisionRequest.schema.json",
  "title": "Authorized reviewer decision",
  "type": "object",
  "properties": {
    "decision": { "enum": ["APPROVED", "REJECTED"] },
    "labelSlug": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 96
    },
    "notes": { "type": ["string", "null"], "maxLength": 1000 }
  },
  "required": ["decision"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "APPROVED" } }, "required": ["decision"] },
      "then": { "properties": { "labelSlug": { "type": "string" } }, "required": ["labelSlug"] }
    },
    {
      "if": { "properties": { "decision": { "const": "REJECTED" } }, "required": ["decision"] },
      "then": { "properties": { "labelSlug": { "type": "null" } } }
    }
  ]
}
