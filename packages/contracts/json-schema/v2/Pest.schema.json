{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sids.local/contracts/v2/Pest.schema.json",
  "title": "Promoted public insect catalog entry",
  "type": "object",
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 96 },
    "kind": { "$ref": "IdentificationMode.schema.json" },
    "commonName": { "type": "string", "minLength": 1, "maxLength": 160 },
    "scientificName": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "imageUrl": { "oneOf": [{ "type": "string", "format": "uri-reference", "maxLength": 255 }, { "type": "null" }] },
    "affectedCrops": {
      "type": "array",
      "items": { "$ref": "Crop.schema.json" },
      "maxItems": 50
    },
    "guidance": { "oneOf": [{ "$ref": "https://sids.local/contracts/v1/PestGuidance.schema.json" }, { "type": "null" }] },
    "generalGuidance": { "oneOf": [{ "$ref": "GeneralInsectGuidance.schema.json" }, { "type": "null" }] }
  },
  "required": ["id", "slug", "kind", "commonName", "scientificName", "description", "imageUrl", "affectedCrops", "guidance", "generalGuidance"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "CROP_PEST" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "affectedCrops": { "minItems": 1 },
          "generalGuidance": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "GENERAL_INSECT" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "affectedCrops": { "maxItems": 0 },
          "guidance": { "type": "null" }
        }
      }
    }
  ]
}
