{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sids.local/contracts/v2/ScanResult.schema.json",
  "title": "Authorized public multi-mode scan result",
  "type": "object",
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "mode": { "$ref": "IdentificationMode.schema.json" },
    "crop": { "oneOf": [{ "$ref": "Crop.schema.json" }, { "type": "null" }] },
    "status": { "enum": ["IDENTIFIED", "UNKNOWN", "REJECTED_IMAGE", "FAILED"] },
    "reason": { "type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "bbox": { "oneOf": [{ "$ref": "https://sids.local/contracts/v1/BoundingBox.schema.json" }, { "type": "null" }] },
    "imageUrl": { "type": ["string", "null"], "format": "uri-reference" },
    "pest": { "oneOf": [{ "$ref": "Pest.schema.json" }, { "type": "null" }] },
    "model": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "datasetVersion": { "type": "string", "minLength": 1 }
          },
          "required": ["id", "version", "datasetVersion"],
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "trainingConsent": { "type": "boolean" },
    "consentedAt": { "type": ["string", "null"], "format": "date-time" },
    "reviewStatus": { "$ref": "ReviewStatus.schema.json" },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "required": ["id", "mode", "crop", "status", "reason", "confidence", "bbox", "imageUrl", "pest", "model", "trainingConsent", "consentedAt", "reviewStatus", "createdAt"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "CROP_PEST" } }, "required": ["mode"] },
      "then": {
        "properties": {
          "crop": { "type": "object" },
          "pest": {
            "oneOf": [
              {
                "allOf": [
                  { "$ref": "Pest.schema.json" },
                  { "properties": { "kind": { "const": "CROP_PEST" } }, "required": ["kind"] }
                ]
              },
              { "type": "null" }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "GENERAL_INSECT" } }, "required": ["mode"] },
      "then": {
        "properties": {
          "crop": { "type": "null" },
          "pest": {
            "oneOf": [
              {
                "allOf": [
                  { "$ref": "Pest.schema.json" },
                  { "properties": { "kind": { "const": "GENERAL_INSECT" } }, "required": ["kind"] }
                ]
              },
              { "type": "null" }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "IDENTIFIED" } }, "required": ["status"] },
      "then": {
        "properties": {
          "reason": { "type": "null" },
          "confidence": { "type": "number" },
          "pest": { "type": "object" },
          "model": { "type": "object" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "UNKNOWN" } }, "required": ["status"] },
      "then": {
        "properties": {
          "reason": { "enum": ["LOW_CONFIDENCE", "NO_DETECTION", "CLASS_UNCERTAIN", "MODEL_UNAVAILABLE", "UNSUPPORTED_MODE"] },
          "confidence": { "type": "null" },
          "bbox": { "type": "null" },
          "pest": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "REJECTED_IMAGE" } }, "required": ["status"] },
      "then": {
        "properties": {
          "reason": { "enum": ["TOO_DARK", "TOO_BRIGHT", "TOO_BLURRY", "SUBJECT_TOO_SMALL", "NO_INSECT_CANDIDATE", "INVALID_IMAGE"] },
          "confidence": { "type": "null" },
          "bbox": { "type": "null" },
          "pest": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "FAILED" } }, "required": ["status"] },
      "then": {
        "properties": {
          "reason": { "type": "string" },
          "confidence": { "type": "null" },
          "bbox": { "type": "null" },
          "pest": { "type": "null" },
          "model": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "trainingConsent": { "const": true } }, "required": ["trainingConsent"] },
      "then": { "properties": { "consentedAt": { "type": "string", "format": "date-time" } } },
      "else": { "properties": { "consentedAt": { "type": "null" } } }
    },
    {
      "if": { "properties": { "reviewStatus": { "const": "PENDING" } }, "required": ["reviewStatus"] },
      "then": { "properties": { "trainingConsent": { "const": true } } }
    }
  ]
}
