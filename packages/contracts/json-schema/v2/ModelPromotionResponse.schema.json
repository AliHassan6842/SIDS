{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sids.local/contracts/v2/ModelPromotionResponse.schema.json",
  "title": "Immutable model promotion audit record",
  "type": "object",
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "modelId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "modelVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
    "datasetVersion": { "type": "string", "minLength": 1, "maxLength": 120 },
    "manifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "supersedesPromotionId": { "type": ["string", "null"], "format": "uuid" },
    "reviewIds": { "type": "array", "items": { "type": "string", "format": "uuid" }, "maxItems": 1000, "uniqueItems": true },
    "promotedBy": { "type": "string", "format": "uuid" },
    "promotedAt": { "type": "string", "format": "date-time" }
  },
  "required": ["id", "modelId", "modelVersion", "datasetVersion", "manifestSha256", "artifactSha256", "supersedesPromotionId", "reviewIds", "promotedBy", "promotedAt"],
  "additionalProperties": false
}
