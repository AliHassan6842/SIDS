{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sids.local/contracts/v1/RegisterRequest.schema.json",
  "title": "Register request",
  "type": "object",
  "properties": {
    "email": { "type": "string", "format": "email", "maxLength": 320 },
    "fullName": { "type": "string", "minLength": 2, "maxLength": 120, "pattern": ".*\\S.*" },
    "password": { "type": "string", "minLength": 10, "maxLength": 128, "pattern": ".*\\S.*" },
    "language": { "type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$", "default": "en" }
  },
  "required": ["email", "fullName", "password"],
  "additionalProperties": false
}
