{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sids.ai/schema/AnalysisResponse.schema.json",
  "title": "AnalysisResponse",
  "description": "Result of an AI image analysis.",
  "type": "object",
  "properties": {
    "analysisId": {
      "type": "string",
      "format": "uuid"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": ["SUCCESS", "FAILED", "REJECTED_QUALITY"],
      "description": "Overall status of the analysis."
    },
    "quality": {
      "$ref": "ImageQuality.schema.json"
    },
    "routing": {
      "type": "object",
      "description": "The result of the routing phase (whether this is pest, disease, healthy, etc).",
      "properties": {
        "problemType": {
          "type": "string",
          "enum": ["PEST", "DISEASE", "DAMAGE", "HEALTHY", "UNCERTAIN"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": ["problemType"]
    },
    "predictions": {
      "type": "array",
      "description": "List of model predictions found in the image.",
      "items": {
        "$ref": "Prediction.schema.json"
      }
    },
    "processingTimeMs": {
      "type": "integer",
      "minimum": 0,
      "description": "Total processing time in milliseconds."
    },
    "error": {
      "$ref": "ErrorModel.schema.json"
    }
  },
  "required": ["analysisId", "status", "quality", "routing"]
}
